<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Referencing the project rather than its packages directly, so this probe inherits
      SemanticStart.Core's pinned Microsoft.ML.OnnxRuntime/org.k2fsa.sherpa.onnx pair and the
      ResolveDuplicateOnnxRuntimeNative target that picks one onnxruntime.dll between them. Pinning
      those versions again here would only create a second place for the pair to drift apart.
    -->
    <ProjectReference Include="..\..\src\SemanticStart.Core\SemanticStart.Core.csproj" />
  </ItemGroup>

</Project>
